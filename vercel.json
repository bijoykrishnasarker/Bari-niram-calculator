{
  "version": 2,
  "framework": null,
  "buildCommand": "pnpm --filter @homexbd/shared build && pnpm --filter @homexbd/api build",
  "builds": [
    {
      "src": "apps/api/dist/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/api/dist/server.js"
    }
  ]
}
