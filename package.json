{
  "name": "homexbd-house-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --filter @homexbd/shared build && pnpm --filter @homexbd/api build",
    "dev:api": "pnpm --filter @homexbd/api dev",
    "dev:mobile": "pnpm --filter @homexbd/mobile start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "@types/node": "26.6.6",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "typescript": "7.0.2"
  }
}
