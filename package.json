{
  "name": "homexbd-house-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --filter @homexbd/shared build && pnpm --filter @homexbd/api build",
    "dev:api": "pnpm --filter @homexbd/api dev",
    "dev:mobile": "pnpm --filter @homexbd/mobile start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "typescript": "7.0.2"
  }
}
